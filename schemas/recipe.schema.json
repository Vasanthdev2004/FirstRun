{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FirstRun Recipe v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "steps",
    "start"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "start": {
      "$ref": "#/$defs/step"
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argv",
        "cwd",
        "timeout_seconds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,39}$"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^[^\\u0000\\r\\n]+$"
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    }
  },
  "$comment": "Shape only. IDs must also be unique, cwd must be normalized/contained, and policy must authorize each command. Target/verifier/permission fields are deliberately absent."
}
